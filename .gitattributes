# Normalize all text files to LF on commit, checkout as-is on Windows
* text=auto eol=lf

# Binaries — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pt binary
*.pth binary
*.onnx binary
