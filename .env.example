# =============================================================================
# Plant Disease Detection Platform — Environment Variables
# =============================================================================
# Copy this file to a local .env or config.yaml and fill in your values.
# NEVER commit files containing real credentials.
# =============================================================================

# ─── Go Core Service (runs on port 8080) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=plant_disease_db
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_EXPIRY_MINUTES=15

# ─── Python AI Service (runs on port 8000) ───────────────────────────────────
API_PORT=8000
TRITON_SERVER_URL=localhost:8001
MODEL_NAME=plant_disease_model
MODEL_VERSION=1
IMAGE_SIZE=224
RABBITMQ_BROKER_URL=pyamqp://guest:guest@localhost:5672//
