# =============================================================================
# Plant Disease Detection Platform — Environment Variables
# =============================================================================
# Copy this file to a root .env and fill in real values before running.
# The docker-compose.yml reads several of these via ${VAR:-default} syntax.
# NEVER commit files containing real credentials.
# =============================================================================

# ─── Go Core Service (runs on port 8080) ─────────────────────────────────────
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=plant_disease_db
DB_SSLMODE=disable
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_EXPIRY_MINUTES=60

# URL of the Python AI service (used by the Go handler to call /infer)
AI_SERVICE_URL=http://localhost:8000

# AMQP connection for async job dispatch (Go → RabbitMQ → Celery)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── Python AI Service (runs on port 8000) ───────────────────────────────────
API_PORT=8000

# Triton gRPC endpoint (production inference server)
TRITON_SERVER_URL=localhost:8001
MODEL_NAME=plant_disease_model
MODEL_VERSION=1
IMAGE_SIZE=224

# Celery message broker + result backend
RABBITMQ_BROKER_URL=pyamqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Callback URL — Go core-service internal endpoint for Celery to notify on completion
CORE_SERVICE_INTERNAL_URL=http://localhost:8080

# ─── HuggingFace Serverless Inference API ────────────────────────────────────
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your_token_here
HF_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
